#!/usr/bin/env bash
set -euo pipefail
cgl_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cgl_target="${CGL_PYTHON_TARGET:-$HOME/.local/share/cgl/python3.14}"
export PYTHONPATH="$cgl_root/src:$cgl_target"
export CGL_ROOT="${CGL_ROOT:-$cgl_root}"
export PYTHONNOUSERSITE=1
# Prefer the wheel's CUDA runtime, preserving the Windows-owned WSL driver.
export LD_LIBRARY_PATH="${CGL_DRIVER_LIBRARY_PATH:-/usr/lib/wsl/lib}"
exec uv run --no-project --python 3.14 python -m cgl "$@"
